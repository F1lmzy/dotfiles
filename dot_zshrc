# Managed by chezmoi. Edit with: chezmoi edit ~/.zshrc
# Keep machine-specific overrides in ~/.config/zsh/local.zsh (not managed).
typeset -U path PATH
path=("$HOME/.local/bin" $path)

# Homebrew on Apple Silicon or Intel macOS.
if [[ "$OSTYPE" == darwin* ]]; then
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x "$brew_bin" ]]; then
      eval "$("$brew_bin" shellenv)"
      break
    fi
  done
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="gozilla"
plugins=(git)
for plugin in zsh-autosuggestions zsh-autocomplete zsh-syntax-highlighting; do
  [[ -d "${ZSH_CUSTOM:-$ZSH/custom}/plugins/$plugin" ]] && plugins+=("$plugin")
done
(( $+commands[brew] )) && plugins+=(brew)
for completions in "${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-completions/src" "${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-autocomplete/Completions"; do
  [[ -d "$completions" ]] && fpath+=("$completions")
done
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit && compinit
  HISTFILE="$HOME/.zsh_history"
  HISTSIZE=10000
  SAVEHIST=10000
  setopt appendhistory
fi

export EDITOR="${EDITOR:-nvim}"
if [[ -d /usr/share/omarchy ]]; then
  export SUDO_EDITOR="$EDITOR"
  export BROWSER="${BROWSER:-omarchy-launch-browser}"
  export BAT_THEME=ansi
  export MANROFFOPT="-c"
  if (( $+commands[bat] )); then
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  fi
  [[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap
  (( $+commands[fzf] )) && [[ -r /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
  if (( $+commands[eza] )); then
    alias ls='eza -lh --group-directories-first --icons=auto'
    alias lsa='ls -a'
    alias lt='eza --tree --level=2 --long --icons --git'
    alias lta='lt -a'
  fi
  (( $+commands[fzf] && $+commands[bat] )) && alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
fi

[[ -r "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
[[ -r "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
[[ -r "$HOME/.opam/opam-init/init.zsh" ]] && source "$HOME/.opam/opam-init/init.zsh"
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
[[ -d "$PNPM_HOME" ]] && path=("$PNPM_HOME" $path)
for tool_bin in "$HOME/.juliaup/bin" "$HOME/.antigravity/antigravity/bin" "$HOME/.lmstudio/bin" "$HOME/.platformio/penv/bin"; do
  [[ -d "$tool_bin" ]] && path+=("$tool_bin")
done
export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
[[ -d "$BUN_INSTALL/bin" ]] && path=("$BUN_INSTALL/bin" $path)
[[ -r "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"
(( $+commands[mise] )) && eval "$(mise activate zsh)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

if [[ "$OSTYPE" == darwin* ]]; then
  for tex_bin in /usr/local/texlive/bin/universal-darwin /Library/TeX/texbin; do
    [[ -d "$tex_bin" ]] && path=("$tex_bin" $path)
  done
fi
# Initialize conda only where installed; never insert a nonexistent path.
for conda_root in "$HOME/miniconda3" "$HOME/anaconda3" /opt/miniconda3; do
  if [[ -r "$conda_root/etc/profile.d/conda.sh" ]]; then
    source "$conda_root/etc/profile.d/conda.sh"
    break
  fi
done

alias clear='TERM=xterm clear'
if [[ "$TERM_PROGRAM" == kiro ]] && (( $+commands[kiro] )); then
  source "$(kiro --locate-shell-integration-path zsh)"
fi
if (( $+commands[neofetch] )); then
  neofetch
elif (( $+commands[fastfetch] )); then
  fastfetch
fi
[[ -r "$HOME/.config/zsh/local.zsh" ]] && source "$HOME/.config/zsh/local.zsh"
# Optional local file absent is normal, not a startup failure.
true
